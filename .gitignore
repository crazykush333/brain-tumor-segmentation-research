# ---------------------------------------------------------------------------
# Medical / study data — NEVER commit (see docs/data/DATA_ACCESS.md)
# ---------------------------------------------------------------------------
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.nrrd
*.mgz
*.h5
*.hdf5
*.npz
*.npy
*.pkl
*.pickle
# Root-level data directories only (anchored, so src/brats_uncertainty/data/
# and docs/data/ are NOT ignored). Everything under /data/ is private research
# data (raw/, manifests/, derived/, cache/); only its README is tracked.
/data/*
!/data/README.md
# Archives and spreadsheets are treated as potential data/metadata.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.xlsx
*.xls
# Label volumes (redundant with *.nii.gz, kept explicit)
*_seg.nii*
*-seg.nii*
/raw_data/
/study_data/
/nnUNet_raw/
/nnUNet_preprocessed/
/nnUNet_results/
**/predictions/
# Licensed metadata files are not redistributed (IDs-only derivatives may be).
BraTS2021_MappingToTCIA.xlsx
UCSF-PDGM-metadata*.csv
BraTS-Africa_TCIA_datainfo*.xlsx

