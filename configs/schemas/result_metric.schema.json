{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brats-uncertainty/result_metric.schema.json",
  "title": "RESULT METRIC FILE (*.metrics.json)",
  "description": "One scientific number = one fully attributed record. Validated in code by brats_uncertainty.results.metric_records (kept in sync by tests). Synthetic records can never be published.",
  "type": "object",
  "required": ["schema_version", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "experiment_id",
        "condition",
        "metric",
        "value",
        "unit",
        "population",
        "dataset_role",
        "seed_or_ensemble",
        "arm",
        "protocol_version",
        "git_commit",
        "dataset_hash",
        "split_hash",
        "config_hash",
        "synthetic"
      ],
      "additionalProperties": false,
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,31}$"},
        "condition": {
          "type": "string",
          "pattern": "^(Full|-T1|-T1c|-T2|-FLAIR|C4_mean|subset:(T1|T1c|T2|FLAIR)(\\+(T1|T1c|T2|FLAIR)){0,3})$"
        },
        "metric": {
          "enum": [
            "dice_ET", "dice_TC", "dice_WT", "risk", "aurc", "delta_aurc", "coverage",
            "selective_risk", "delta_risk", "delta_coverage", "threshold_tau", "ece", "brier",
            "volume_relative_error", "volume_failure_rate", "n_cases", "n_patient_groups"
          ]
        },
        "value": {"type": "number"},
        "unit": {"enum": ["proportion", "dimensionless", "count"]},
        "population": {"type": "string", "minLength": 1},
        "dataset_role": {"enum": ["validation", "internal_test", "upenn_hoi", "brats_africa"]},
        "seed_or_ensemble": {"type": "string", "pattern": "^(ensemble|seed:[012])$"},
        "arm": {"enum": ["A", "B"]},
        "protocol_version": {"const": "v1.0"},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "synthetic": {"type": "boolean"},
        "uncertainty": {"enum": ["U1", "U2", "U3", "I", null]},
        "ci_lower": {"type": "number"},
        "ci_upper": {"type": "number"},
        "ci_method": {"enum": ["percentile", "BCa"]},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "n": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    }
  }
}
